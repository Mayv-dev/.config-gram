// Gram settings
//
// For information on how to configure Gram, see the Gram
// documentation: gram://docs/configuring-gram
//
// To see all of Gram's default settings without changing your
// custom settings, run `gram: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "git": {
    "inline_blame": {
      "show_commit_summary": false,
      "min_column": 80,
      "padding": 10,
      "delay_ms": 500,
      "enabled": true
    }
  },
  "preview_tabs": {
    "enable_preview_file_from_code_navigation": true,
    "enabled": true,
  },
  "tabs": {
    "show_close_button": "hover",
    "file_icons": true,
    "git_status": true,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": true,
    "show": false,
  },
  "title_bar": {
    "show_menus": false,
    "show_onboarding_banner": true,
    "show_project_items": true,
    "show_branch_icon": true,
  },
  "status_bar": {
    "cursor_position_button": true,
    "active_language_button": true,
    "active_file": true,
    "show": true,
  },
  "colorize_brackets": true,
  "indent_guides": {
    "background_coloring": "disabled",
    "line_width": 2,
    "active_line_width": 3,
    "coloring": "indent_aware",
  },
  "toolbar": {
    "code_actions": true,
    "selections_menu": true,
    "quick_actions": true,
    "breadcrumbs": true,
  },
  "minimap": {
    "show": "never",
    "thumb": "always",
  },
  "languages": {
    "Zig": {
      "tab_size": 4,
    },
  },
  "node": {
    "allow_binary_download": false,
  },
  "lsp": {
    "json-language-server": {
      "binary": {
        "allow_binary_download": false,
      },
      "enable_lsp_tasks": true,
    },
    "zls": {
      "binary": {
        "path": "~/.local/share/mise/installs/zls/0.16.0/zls",
      },
      "enable_lsp_tasks": true,
    },
  },
  "buffer_line_height": "standard",
  "outline_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "project_panel": {
    "button": true,
    "dock": "right",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Gram (Default)",
    "dark": "Gram (Default)",
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 10.0,
  "gutter": {
    "line_numbers": true,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "buffer_font_family": "JetBrains Mono",
  "show_whitespaces": "boundary",
  "wrap_guides": [80, 120],
  "hard_tabs": false,
  "tab_size": 2,
  "ui_font_size": 16.0,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "system",
    "light": "Rosé Pine Dawn",
    "dark": "Rosé Pine Moon",
  },
  "use_system_path_prompts": false,
  "terminal": {
    "font": "JetBrainsMono-Regular",
    "dock": "bottom",
    "font_size": 16.0,
    "shell": {
      "with_arguments": {
        "program": "/bin/zsh",
        "args": [
          "-c",
          "tmux new-session -A -s \"$(basename \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\")\" -c \"$(pwd)\"",
        ],
      },
    },
  },
}
